# Copy to /etc/bestmovechess.env and uncomment what you want to change.
#HOST=127.0.0.1
#PORT=8000
#STOCKFISH_PATH=/usr/games/stockfish
#ENGINE_THREADS=2
#ENGINE_HASH_MB=64
#DEFAULT_DEPTH=15
#MAX_DEPTH=25
#ENGINE_MAX_SECONDS=10
#MAX_UPLOAD_MB=10
#MODEL_PATH=/opt/bestmovechess/models/square_cnn.onnx
#VISION_THREADS=2
#MAX_IMAGE_PIXELS=50000000
#PUBLIC_BASE_URL=https://your-host.example
#LOG_LEVEL=INFO
#PROFILE_DIR=/var/lib/bestmovechess/profiles
#LC0_PATH=/usr/local/bin/lc0
#LC0_BACKEND=blas
#MAIA_DIR=/opt/bestmovechess/models/maia
#UCI_ENGINES={"rodent": {"path": "/opt/rodent/rodent", "label": "Rodent IV"}}
#MAX_LIVE_ENGINES=2
